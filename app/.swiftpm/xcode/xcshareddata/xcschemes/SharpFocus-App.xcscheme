<?xml version="1.0" encoding="UTF-8"?>
<Scheme LastUpgradeVersion="1630" version="1.7">
   <BuildAction parallelizeBuildables="YES" buildImplicitDependencies="YES">
      <PreActions>
         <ExecutionAction ActionType="Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent title="Bundle debug .app" scriptText="set -e&#10;cd &quot;${SRCROOT}/../..&quot;&#10;# Ensure icon exists, then build a debuggable .app bundle&#10;CONFIG=${CONFIGURATION:-Debug}&#10;if [ &quot;$CONFIG&quot; = &quot;Release&quot; ]; then&#10;  ./Scripts/bundle.sh&#10;else&#10;  # debug bundle: swift build -c debug + ad-hoc sign + reuse same layout&#10;  swift build -c debug&#10;  APP=build/SharpFocus.app&#10;  rm -rf &quot;$APP&quot;&#10;  mkdir -p &quot;$APP/Contents/MacOS&quot; &quot;$APP/Contents/Resources&quot;&#10;  cp .build/debug/SharpFocus &quot;$APP/Contents/MacOS/SharpFocus&quot;&#10;  if [ -f .build/debug/sfctl ]; then cp .build/debug/sfctl &quot;$APP/Contents/MacOS/sfctl&quot;; fi&#10;  if [ ! -f build/AppIcon.icns ]; then&#10;    swift Scripts/make-icon.swift build/AppIcon.iconset&#10;    iconutil -c icns build/AppIcon.iconset -o build/AppIcon.icns&#10;  fi&#10;  cp build/AppIcon.icns &quot;$APP/Contents/Resources/AppIcon.icns&quot;&#10;  cat &gt; &quot;$APP/Contents/Info.plist&quot; &lt;&lt;PLIST&#10;&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&#10;&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;&#10;&lt;plist version=&quot;1.0&quot;&gt;&#10;&lt;dict&gt;&#10;	&lt;key&gt;CFBundlePackageType&lt;/key&gt;&lt;string&gt;APPL&lt;/string&gt;&#10;	&lt;key&gt;CFBundleName&lt;/key&gt;&lt;string&gt;SharpFocus&lt;/string&gt;&#10;	&lt;key&gt;CFBundleDisplayName&lt;/key&gt;&lt;string&gt;Sharp Focus&lt;/string&gt;&#10;	&lt;key&gt;CFBundleIdentifier&lt;/key&gt;&lt;string&gt;de.beyond925.SharpFocus&lt;/string&gt;&#10;	&lt;key&gt;CFBundleExecutable&lt;/key&gt;&lt;string&gt;SharpFocus&lt;/string&gt;&#10;	&lt;key&gt;CFBundleIconFile&lt;/key&gt;&lt;string&gt;AppIcon&lt;/string&gt;&#10;	&lt;key&gt;CFBundleShortVersionString&lt;/key&gt;&lt;string&gt;0.2.0&lt;/string&gt;&#10;	&lt;key&gt;CFBundleVersion&lt;/key&gt;&lt;string&gt;0.2.0&lt;/string&gt;&#10;	&lt;key&gt;LSMinimumSystemVersion&lt;/key&gt;&lt;string&gt;14.0&lt;/string&gt;&#10;	&lt;key&gt;LSUIElement&lt;/key&gt;&lt;true/&gt;&#10;&lt;/dict&gt;&#10;&lt;/plist&gt;&#10;PLIST&#10;  codesign --force --sign - &quot;$APP&quot;&#10;  echo &quot;Bundled $APP ($CONFIG)&quot;&#10;fi"><EnvironmentBuildable><BuildableReference BuildableIdentifier="primary" BlueprintIdentifier="SharpFocus" BuildableName="SharpFocus" BlueprintName="SharpFocus" ReferencedContainer="container:"></BuildableReference></EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry buildForTesting="YES" buildForRunning="YES" buildForProfiling="YES" buildForArchiving="YES" buildForAnalyzing="YES">
            <BuildableReference BuildableIdentifier="primary" BlueprintIdentifier="SharpFocus" BuildableName="SharpFocus" BlueprintName="SharpFocus" ReferencedContainer="container:"></BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction buildConfiguration="Debug" selectedDebuggerIdentifier="Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier="Xcode.DebuggerFoundation.Launcher.LLDB" shouldUseLaunchSchemeArgsEnv="YES" shouldAutocreateTestPlan="YES"/>
   <LaunchAction buildConfiguration="Debug" selectedDebuggerIdentifier="Xcode.DebuggerFoundation.Debugger.LLDB" selectedLauncherIdentifier="Xcode.DebuggerFoundation.Launcher.LLDB" launchStyle="0" useCustomWorkingDirectory="NO" ignoresPersistentStateOnLaunch="NO" debugDocumentVersioning="YES" debugServiceExtension="internal" allowLocationSimulation="YES">
      <PathRunnable runnableDebuggingMode="0" FilePath="build/SharpFocus.app/Contents/MacOS/SharpFocus"/>
   </LaunchAction>
   <ProfileAction buildConfiguration="Release" shouldUseLaunchSchemeArgsEnv="YES" savedToolIdentifier="" useCustomWorkingDirectory="NO" debugDocumentVersioning="YES">
      <PathRunnable runnableDebuggingMode="0" FilePath="build/SharpFocus.app/Contents/MacOS/SharpFocus"/>
   </ProfileAction>
   <AnalyzeAction buildConfiguration="Debug"/>
   <ArchiveAction buildConfiguration="Release" revealArchiveInOrganizer="YES"/>
</Scheme>
