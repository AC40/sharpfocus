    if (!reduceMotion && toggle && !state.enabled) {
      const label = toggle.closest(".sf-switch");
      window.setTimeout(() => label?.classList.add("nudge"), 2200);
      const stop = (): void => label?.classList.remove("nudge");
      toggle.addEventListener("focus", stop);
      toggle.addEventListener("change", stop);
      label?.addEventListener("pointerenter", stop);
    }

    render();
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-sf-demo]")) {
    if (root.dataset["sfMounted"] === "1") continue;
    root.dataset["sfMounted"] = "1";
    mount(root);
  }
