    const clock = q<HTMLElement>(desktop, "[data-sf-clock]");
    const tick = (): void => {
      if (!clock) return;
      clock.textContent = new Intl.DateTimeFormat(undefined, {
        weekday: "short", hour: "2-digit", minute: "2-digit",
