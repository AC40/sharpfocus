    };
    tick();
    window.setInterval(tick, 20_000);

    /* scale the 1200×760 design space into the available width; below a
       floor the desktop stops shrinking and pans instead */
    const fit = (): void => {
      const floor = window.innerWidth < 720 ? 0.5 : 0;
      const s = Math.max(stage.clientWidth / STAGE_W, floor);
