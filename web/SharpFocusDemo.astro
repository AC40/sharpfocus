---
/**
 * SharpFocusDemo — a self-contained, interactive "fake macOS desktop" that
 * shows what Sharp Focus does: flip the switch and every window except the
 * focused one is desaturated, blurred and dimmed.
 *
 * Drop this file into any Astro project and use it like:
 *
 *   ---
 *   import SharpFocusDemo from "../components/SharpFocusDemo.astro";
 *   ---
 *   <SharpFocusDemo />
 *
 * Fully isolated: everything lives under the `.sf-demo` root, no element IDs
 * leak out, several instances per page are fine, and it has no dependencies.
 * Fonts: set `--sf-sans` / `--sf-mono` on the host (or pass `class`) to use
 * your own; otherwise it falls back to system fonts.
 */
interface Props {
  /** Extra classes for the root element. */
  class?: string;
  /** Start with the effect switched on. */
  enabled?: boolean;
  /** Initial grayscale (0–100), blur (0–40 px) and dimming (0–90). */
  grayscale?: number;
  blur?: number;
  dim?: number;
  /** Listen for ⌃⌥⌘F on the page, like the real app's global shortcut. */
  hotkey?: boolean;
  /** Small line under the controls; pass "" to hide. */
  caption?: string;
}

const {
  class: className = "",
  enabled = false,
  grayscale = 100,
  blur = 6,
  dim = 35,
  hotkey = true,
  caption = "The menu bar and the Dock stay untouched — the overlay sits below them, exactly like the app does.",
} = Astro.props;

// Unique suffix so <label for> works with several demos on one page.
const uid = Math.random().toString(36).slice(2, 8);
---

<div
  class:list={["sf-demo", className]}
  data-sf-demo
  data-enabled={enabled ? "1" : "0"}
  data-grayscale={grayscale}
  data-blur={blur}
  data-dim={dim}
  data-hotkey={hotkey ? "1" : "0"}
>
  <div
    class="sf-stage"
    data-sf-stage
    tabindex="0"
    role="region"
    aria-label="Interactive demo: a simulated macOS desktop"
  >
    <div class="sf-stage-inner">
      <div class="sf-desktop" data-sf-desktop></div>
    </div>
  </div>
  <p class="sf-pan-hint" data-sf-pan-hint hidden>Drag sideways to see the rest</p>

  <div class="sf-controls" data-sf-controls>
    <div class="sf-control-main">
      <label class="sf-switch" for={`sf-toggle-${uid}`}>
        <input type="checkbox" id={`sf-toggle-${uid}`} role="switch" data-sf-toggle />
        <span class="sf-switch-track" aria-hidden="true"><span class="sf-switch-knob"></span></span>
        <span class="sf-switch-text">
          <span class="sf-switch-label">Sharp Focus</span>
          <span class="sf-switch-state" data-sf-toggle-state>Off</span>
        </span>
      </label>
      <kbd class="sf-hotkey" title="The real shortcut works on this page too">
        <span>⌃</span><span>⌥</span><span>⌘</span><span>F</span>
      </kbd>
    </div>

    <div class="sf-control-grid">
      <fieldset class="sf-sliders">
        <legend>Filter</legend>
        <div class="sf-slider-row">
          <label for={`sf-grayscale-${uid}`}>Grayscale</label>
          <input type="range" id={`sf-grayscale-${uid}`} min="0" max="100" step="1" value={grayscale} data-sf-slider="grayscale" />
          <output for={`sf-grayscale-${uid}`} data-sf-out="grayscale">{grayscale}%</output>
        </div>
        <div class="sf-slider-row">
          <label for={`sf-blur-${uid}`}>Blur</label>
          <input type="range" id={`sf-blur-${uid}`} min="0" max="40" step="1" value={blur} data-sf-slider="blur" />
          <output for={`sf-blur-${uid}`} data-sf-out="blur">{blur} px</output>
        </div>
        <div class="sf-slider-row">
          <label for={`sf-dim-${uid}`}>Dimming</label>
          <input type="range" id={`sf-dim-${uid}`} min="0" max="90" step="1" value={dim} data-sf-slider="dim" />
          <output for={`sf-dim-${uid}`} data-sf-out="dim">{dim}%</output>
        </div>
      </fieldset>

      <div class="sf-control-side">
        <fieldset class="sf-modes">
          <legend>Keep in color</legend>
          <div class="sf-segmented">
            <label>
              <input type="radio" name={`sf-mode-${uid}`} value="window" checked data-sf-mode />
              <span>Focused window</span>
            </label>
            <label>
              <input type="radio" name={`sf-mode-${uid}`} value="app" data-sf-mode />
              <span>All windows of the app</span>
            </label>
          </div>
          <p class="sf-hint">Ember has two windows open — switch modes to see both stay sharp.</p>
        </fieldset>

        <fieldset class="sf-presets">
          <legend>Presets</legend>
          <div class="sf-chips" data-sf-presets>
            <button type="button" data-sf-preset="deep">Deep Work</button>
            <button type="button" data-sf-preset="soft">Soft Focus</button>
            <button type="button" data-sf-preset="mono">Monochrome</button>
          </div>
        </fieldset>
      </div>
    </div>
  </div>

  {caption && <p class="sf-caption">{caption}</p>}
</div>

<script>
  /* ── types ────────────────────────────────────────────────────────────── */
  type WindowId = "browser" | "chat" | "calendar" | "editor" | "build" | "music";
  type Mode = "window" | "app";

  interface WindowDef {
    id: WindowId;
    app: string;
    title: string;
    x: number;
    y: number;
    w: number;
    h: number;
    z: number;
    dark: boolean;
    body: string;
  }

  interface DemoState {
    enabled: boolean;
    grayscale: number;
    blur: number;
    dim: number;
    mode: Mode;
    focus: WindowId;
  }

  interface Preset {
    grayscale: number;
    blur: number;
    dim: number;
  }

  const PRESETS: Record<string, Preset> = {
    deep: { grayscale: 100, blur: 12, dim: 55 },
    soft: { grayscale: 55, blur: 3, dim: 22 },
    mono: { grayscale: 100, blur: 0, dim: 0 },
  };

  const STAGE_W = 1200;
  const FOCUS_CENTER_X = 512;

  /* ── markup helpers ───────────────────────────────────────────────────── */
  const times = (n: number, fn: (i: number) => string): string =>
    Array.from({ length: n }, (_, i) => fn(i)).join("");

  const lights = (): string =>
    `<span class="sf-lights" aria-hidden="true"><i class="l-r"></i><i class="l-y"></i><i class="l-g"></i></span>`;

  const CODE: string[] = [
    `<span class="c">// occlusion-aware: a window sitting above a focused</span>`,
    `<span class="c">// one still gets filtered.</span>`,
    `<span class="k">private func</span> <span class="f">rebuildMask</span>(<span class="p">for</span> screen: <span class="t">NSScreen</span>) {`,
    `  <span class="k">let</span> path = <span class="t">CGMutablePath</span>()`,
    `  path.<span class="f">addRect</span>(screen.frame)`,
    ``,
    `  <span class="k">for</span> hole <span class="k">in</span> tracker.<span class="f">holes</span>(on: screen) {`,
    `    <span class="k">guard</span> hole.<span class="v">isVisible</span> <span class="k">else</span> { <span class="k">continue</span> }`,
    `    path.<span class="f">addRoundedRect</span>(<span class="k">in</span>: hole.<span class="v">frame</span>,`,
    `                        cornerWidth: <span class="n">10</span>,`,
    `                        cornerHeight: <span class="n">10</span>)`,
    `  }`,
    ``,
    `  mask.<span class="v">fillRule</span> = .<span class="v">evenOdd</span>`,
    `  overlay.<span class="v">layer</span>?.<span class="v">mask</span> = mask`,
    `}`,
  ];

  const editorBody = (): string => `
    <div class="sf-ed">
      <div class="sf-ed-side">
        <p class="sf-ed-side-h">EMBER</p>
        <ul>
          <li>AppDelegate.swift</li>
          <li class="on">OverlayController.swift</li>
          <li>FocusTracker.swift</li>
          <li>Backdrop.swift</li>
          <li>HotKeys.swift</li>
          <li>Settings.swift</li>
        </ul>
      </div>
      <div class="sf-ed-main">
        <div class="sf-ed-tabs"><span class="on">OverlayController.swift</span><span>FocusTracker.swift</span></div>
        <div class="sf-ed-code">
          <div class="sf-ed-gutter">${times(CODE.length, (i) => `<i>${i + 41}</i>`)}</div>
          <div class="sf-ed-lines">${CODE.map((l) => `<div class="sf-ed-ln">${l || "&nbsp;"}</div>`).join("")}</div>
        </div>
        <div class="sf-ed-status"><span>swift</span><span>Ln 54, Col 21</span><span class="ok">main ✓</span></div>
      </div>
    </div>`;

  const buildBody = (): string => `
    <div class="sf-term">
      <p><span class="pr">~/dev/ember</span> <span class="cm">swift build -c release</span></p>
      <p class="dim">[1/6] Compiling Ember Backdrop.swift</p>
      <p class="dim">[3/6] Compiling Ember OverlayController.swift</p>
      <p class="warn">warning: 'CABackdropLayer' is a private API</p>
      <p class="ok">Build complete! (4.71s)</p>
      <p><span class="pr">~/dev/ember</span> <span class="cur"></span></p>
    </div>`;

  const chatBody = (): string => `
    <div class="sf-chat">
      <div class="sf-chat-head"><span class="sf-ch-name">#design-noise</span><span class="sf-ch-badge">7</span></div>
      <div class="sf-chat-list">
        <div class="sf-msg"><i class="sf-av a1"></i><div class="sf-bub">did you see the new build? the blur is so smooth now</div></div>
        <div class="sf-msg me"><div class="sf-bub b-me">yeah I turned it up to 40 and nearly fell asleep</div></div>
        <div class="sf-msg"><i class="sf-av a2"></i><div class="sf-bub">
          <span class="sf-link-card"><i class="sf-lc-thumb"></i><b>ember-labs/overlay</b><em>github.com</em></span>
        </div></div>
        <div class="sf-msg"><i class="sf-av a3"></i><div class="sf-bub">standup in 5 ⏰</div></div>
        <div class="sf-msg me"><div class="sf-bub b-me">on it</div></div>
        <div class="sf-msg"><i class="sf-av a1"></i><div class="sf-bub sf-typing"><s></s><s></s><s></s></div></div>
      </div>
      <div class="sf-chat-input"><span>Message #design-noise</span></div>
    </div>`;

  const musicBody = (): string => `
    <div class="sf-music">
      <div class="sf-art" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i></div>
      <div class="sf-music-meta">
        <p class="tr">Sunset Diagonal</p>
        <p class="ar">Halogen Rivers</p>
        <div class="sf-wave">${times(20, (i) => `<i style="--h:${28 + ((i * 41) % 72)}%"></i>`)}</div>
        <div class="sf-bar"><i></i></div>
        <div class="tx"><span>1:48</span><span>3:52</span></div>
        <div class="sf-transport">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 5 8 12l9 7zM7 5v14" /></svg>
          <svg viewBox="0 0 24 24" class="play" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l9 7-9 7zM17 5v14" /></svg>
        </div>
      </div>
    </div>`;

  const HEADLINES: string[] = [
    "Every startup is now an AI startup",
    "The 14 best mechanical keyboards",
    "Markets wobble on chip news",
    "Sponsored: your new CRM",
  ];

  const browserBody = (): string => `
    <div class="sf-brw">
      <div class="sf-brw-bar">
        <span class="url">the-daily-byte.example</span>
        <span class="btn"></span><span class="btn"></span>
      </div>
      <div class="sf-brw-page">
        <div class="sf-brw-mast"><b>THE DAILY BYTE</b><span>Tech · Markets · Gadgets · Opinion · Video</span></div>
        <div class="sf-brw-hero">
          <i class="sf-ph ph-1"></i>
          <div class="sf-brw-txt"><b>${HEADLINES[0]}</b><s></s><s class="short"></s></div>
        </div>
        <div class="sf-brw-ad">LIMITED TIME · 40% OFF EVERYTHING</div>
        <div class="sf-brw-grid">
          ${times(3, (i) => `
            <div class="sf-brw-card">
              <i class="sf-ph ph-${i + 2}"></i>
              <b>${HEADLINES[i + 1] ?? ""}</b><s></s><s class="short"></s>
            </div>`)}
        </div>
      </div>
    </div>`;

  const EVENTS: ReadonlyArray<readonly [number, number, string, string]> = [
    [1, 0, "e-a", "Standup"], [2, 1, "e-b", "1:1 Mara"], [3, 1, "e-c", "Design review"],
    [4, 2, "e-a", "Deep work"], [8, 0, "e-d", "Ship 0.1"], [9, 1, "e-b", "Lunch"],
    [11, 0, "e-c", "Retro"], [15, 0, "e-a", "Standup"], [16, 1, "e-d", "Interview"],
    [17, 0, "e-b", "Focus"], [18, 1, "e-c", "Demo"],
  ];

  const calendarBody = (): string => {
    const cells = times(21, (i) => {
      const evs = EVENTS.filter((e) => e[0] === i).map((e) => `<i class="sf-ev ${e[2]}">${e[3]}</i>`).join("");
      return `<div class="sf-cal-cell${i === 3 ? " today" : ""}"><span>${i + 1}</span>${evs}</div>`;
    });
    return `
    <div class="sf-cal">
      <div class="sf-cal-head"><b>September</b><span class="nav"><i></i><i></i></span></div>
      <div class="sf-cal-dow">${["M", "T", "W", "T", "F", "S", "S"].map((d) => `<span>${d}</span>`).join("")}</div>
      <div class="sf-cal-grid">${cells}</div>
    </div>`;
  };

  const WINDOWS: readonly WindowDef[] = [
    { id: "browser", app: "Kestrel", title: "The Daily Byte — Kestrel", x: 430, y: 56, w: 640, h: 392, z: 1, dark: false, body: browserBody() },
    { id: "chat", app: "Chatter", title: "Chatter", x: 40, y: 100, w: 296, h: 372, z: 2, dark: false, body: chatBody() },
    { id: "calendar", app: "Almanac", title: "Almanac", x: 840, y: 320, w: 330, h: 286, z: 3, dark: false, body: calendarBody() },
    { id: "build", app: "Ember", title: "build — Ember", x: 610, y: 514, w: 380, h: 174, z: 4, dark: true, body: buildBody() },
    { id: "music", app: "Turntable", title: "Turntable", x: 62, y: 516, w: 310, h: 160, z: 5, dark: true, body: musicBody() },
    { id: "editor", app: "Ember", title: "OverlayController.swift — Ember", x: 240, y: 158, w: 545, h: 348, z: 6, dark: true, body: editorBody() },
  ];

  const APP_OF: Record<WindowId, string> = WINDOWS.reduce(
    (acc, w) => {
      acc[w.id] = w.app;
      return acc;
    },
    {} as Record<WindowId, string>,
  );

  const menuBar = (): string => `
    <div class="sf-menubar" aria-hidden="true">
      <div class="left">
        <svg class="apple" viewBox="0 0 24 24"><path d="M16.7 12.7c0-2.5 2-3.7 2.1-3.8-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9s-2-.9-3.2-.9c-1.7 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8 2.1-1.2 2.9-2.3c.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.4-1-2.2-3zM14.4 5.4c.7-.8 1.1-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"/></svg>
        <b>Ember</b><span>File</span><span>Edit</span><span>View</span><span>Window</span><span>Help</span>
      </div>
      <div class="right">
        <svg class="sf-mb-sf" data-sf-mb-icon viewBox="0 0 32 32"><circle cx="16" cy="16" r="12" class="ring"/><path d="M16 5.4a10.6 10.6 0 0 1 0 21.2Z" class="fill"/></svg>
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 18.5h.01M4.5 11a10.6 10.6 0 0 1 15 0M7.6 14.3a6.2 6.2 0 0 1 8.8 0"/></svg>
        <svg class="icon" viewBox="0 0 26 24"><rect x="2.5" y="8.5" width="17" height="9" rx="2.6"/><rect x="4.5" y="10.5" width="11" height="5" rx="1.2" class="solid"/><path d="M21.5 11.5v5"/></svg>
        <span class="clock" data-sf-clock>Tue 09:41</span>
      </div>
    </div>`;

  const dock = (): string => `
    <div class="sf-dock" aria-hidden="true">
      <div class="tray">
        ${times(9, (i) => `<i class="dk d${i + 1}${i === 2 || i === 5 ? " running" : ""}"></i>`)}
        <i class="sep"></i>
        <i class="dk d-trash"></i>
      </div>
    </div>`;

  const windowEl = (w: WindowDef, i: number): string => `
    <div class="sf-win ${w.dark ? "dark" : "light"}" data-win="${w.id}" role="button" tabindex="0"
         aria-label="Focus the ${w.title.replace(/"/g, "")} window" aria-pressed="false"
         style="--x:${w.x}px; --y:${w.y}px; --w:${w.w}px; --h:${w.h}px; --z:${w.z}; --i:${i}">
      <div class="sf-win-bar" aria-hidden="true">${lights()}<span class="title">${w.title}</span></div>
      <div class="sf-win-body" aria-hidden="true">${w.body}</div>
    </div>`;

  /* ── one instance ─────────────────────────────────────────────────────── */
  const q = <T extends HTMLElement>(root: ParentNode, sel: string): T | null =>
    root.querySelector<T>(sel);

  const numAttr = (el: HTMLElement, name: string, fallback: number): number => {
    const v = Number.parseInt(el.dataset[name] ?? "", 10);
    return Number.isFinite(v) ? v : fallback;
  };

  function mount(root: HTMLElement): void {
    const stage = q<HTMLElement>(root, "[data-sf-stage]");
    const desktop = q<HTMLElement>(root, "[data-sf-desktop]");
    if (!stage || !desktop) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    desktop.innerHTML = `
      <div class="sf-wallpaper" aria-hidden="true"></div>
      ${menuBar()}
      <div class="sf-win-layer">${WINDOWS.map(windowEl).join("")}</div>
      ${dock()}`;

    const wins = new Map<WindowId, HTMLElement>();
    for (const el of desktop.querySelectorAll<HTMLElement>("[data-win]")) {
      const id = el.dataset["win"] as WindowId | undefined;
      if (id) wins.set(id, el);
    }
    const wallpaper = q<HTMLElement>(desktop, ".sf-wallpaper");
    const mbIcon = q<HTMLElement>(desktop, "[data-sf-mb-icon]");

    const state: DemoState = {
      enabled: root.dataset["enabled"] === "1",
      grayscale: numAttr(root, "grayscale", 100),
      blur: numAttr(root, "blur", 6),
      dim: numAttr(root, "dim", 35),
      mode: "window",
      focus: "editor",
    };

    /* controls */
    const toggle = q<HTMLInputElement>(root, "[data-sf-toggle]");
    const toggleState = q<HTMLElement>(root, "[data-sf-toggle-state]");
    const controls = q<HTMLElement>(root, "[data-sf-controls]");
    const panHint = q<HTMLElement>(root, "[data-sf-pan-hint]");
    const sliders = {
      grayscale: q<HTMLInputElement>(root, '[data-sf-slider="grayscale"]'),
      blur: q<HTMLInputElement>(root, '[data-sf-slider="blur"]'),
      dim: q<HTMLInputElement>(root, '[data-sf-slider="dim"]'),
    } as const;
    const outs = {
      grayscale: q<HTMLOutputElement>(root, '[data-sf-out="grayscale"]'),
      blur: q<HTMLOutputElement>(root, '[data-sf-out="blur"]'),
      dim: q<HTMLOutputElement>(root, '[data-sf-out="dim"]'),
    } as const;

    let topZ = WINDOWS.length;

    const keptInColor = (id: WindowId): boolean =>
      id === state.focus || (state.mode === "app" && APP_OF[id] === APP_OF[state.focus]);

    const filterValue = (): string => {
      const parts: string[] = [];
      if (state.grayscale > 0) parts.push(`grayscale(${state.grayscale}%)`);
      if (state.blur > 0) parts.push(`blur(${state.blur}px)`);
      if (state.dim > 0) parts.push(`brightness(${(1 - state.dim / 100).toFixed(3)})`);
      return parts.length > 0 ? parts.join(" ") : "none";
    };

    const syncControls = (): void => {
      if (toggle) toggle.checked = state.enabled;
      if (toggleState) toggleState.textContent = state.enabled ? "On" : "Off";
      if (sliders.grayscale) sliders.grayscale.value = String(state.grayscale);
      if (sliders.blur) sliders.blur.value = String(state.blur);
      if (sliders.dim) sliders.dim.value = String(state.dim);
      if (outs.grayscale) outs.grayscale.value = `${state.grayscale}%`;
      if (outs.blur) outs.blur.value = `${state.blur} px`;
      if (outs.dim) outs.dim.value = `${state.dim}%`;
      controls?.classList.toggle("live", state.enabled);
      for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-sf-preset]")) {
        const p = PRESETS[btn.dataset["sfPreset"] ?? ""];
        const match = p !== undefined && p.grayscale === state.grayscale && p.blur === state.blur && p.dim === state.dim;
        btn.setAttribute("aria-pressed", String(match));
      }
    };

    const render = (): void => {
      const f = state.enabled ? filterValue() : "none";
      desktop.classList.toggle("on", state.enabled);
      if (wallpaper) wallpaper.style.filter = f;
      mbIcon?.classList.toggle("active", state.enabled);
      for (const [id, el] of wins) {
        const kept = keptInColor(id);
        el.style.filter = kept ? "none" : f;
        el.classList.toggle("kept", state.enabled && kept);
        el.classList.toggle("muted", state.enabled && !kept);
        el.classList.toggle("focused", id === state.focus);
        el.setAttribute("aria-pressed", String(id === state.focus));
      }
      syncControls();
    };

    const raise = (el: HTMLElement): void => {
      topZ += 1;
      el.style.setProperty("--z", String(topZ));
    };

    for (const [id, el] of wins) {
      const focus = (): void => {
        state.focus = id;
        raise(el);
        render();
      };
      el.addEventListener("click", focus);
      el.addEventListener("keydown", (ev: KeyboardEvent) => {
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          focus();
        }
      });
    }

    /* wire the controls */
    toggle?.addEventListener("change", () => {
      state.enabled = toggle.checked;
      render();
    });

    const wireSlider = (el: HTMLInputElement | null, key: "grayscale" | "blur" | "dim"): void => {
      el?.addEventListener("input", () => {
        state[key] = Number.parseInt(el.value, 10) || 0;
        state.enabled = true;
        render();
      });
    };
    wireSlider(sliders.grayscale, "grayscale");
    wireSlider(sliders.blur, "blur");
    wireSlider(sliders.dim, "dim");

    for (const radio of root.querySelectorAll<HTMLInputElement>("[data-sf-mode]")) {
      radio.addEventListener("change", () => {
        if (radio.checked) state.mode = radio.value as Mode;
        state.enabled = true;
        render();
      });
    }

    q<HTMLElement>(root, "[data-sf-presets]")?.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-sf-preset]");
      const preset = btn ? PRESETS[btn.dataset["sfPreset"] ?? ""] : undefined;
      if (!preset) return;
      Object.assign(state, preset, { enabled: true });
      render();
    });

    if (root.dataset["hotkey"] === "1") {
      window.addEventListener("keydown", (ev) => {
        if (ev.ctrlKey && ev.altKey && ev.metaKey && ev.key.toLowerCase() === "f") {
          ev.preventDefault();
          state.enabled = !state.enabled;
